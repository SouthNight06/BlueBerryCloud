{
  "name": "cloudmusic-desktop",
  "productName": "小云畅听",
  "version": "1.0.12",
  "private": true,
  "description": "小云畅听 本地版 · 数据只存本机的多端音乐播放器桌面端",
  "author": "小云屋",
  "desktopName": "cloudmusic.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.cloudmusic",
    "productName": "小云畅听",
    "artifactName": "CloudMusic-Local-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "publish": null,
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "assets/icon.png",
      "executableName": "cloudmusic",
      "synopsis": "小云畅听 · 多端音乐播放器",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    }
  }
}
